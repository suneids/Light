  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #0B0F14;
}

QWidget {
    background-color: #0B0F14;
    color: #D7E2EA;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
}

QFrame {
    background-color: #111821;
    border: 1px solid #223040;
    border-radius: 12px;
}

QLabel {
    color: #D7E2EA;
    background: transparent;
    border: none;
}

QPushButton {
    background-color: #182331;
    color: #D7E2EA;
    border: 1px solid #2C4054;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton:hover {
    background-color: #203044;
    border: 1px solid #00B7C7;
}

QPushButton:pressed {
    background-color: #0E5660;
    border: 1px solid #00E5FF;
}

QPushButton:disabled {
    background-color: #121820;
    color: #5A6570;
    border: 1px solid #202A35;
}

QComboBox, QSpinBox, QSlider, QPlainTextEdit {
    background-color: #0E141B;
    color: #D7E2EA;
    border: 1px solid #2C4054;
    border-radius: 8px;
    padding: 4px;
}

QPlainTextEdit {
    font-family: &quot;Consolas&quot;;
    font-size: 13px;
}

QCheckBox {
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #2C4054;
    background-color: #0E141B;
}

QCheckBox::indicator:checked {
    background-color: #00B7C7;
    border: 1px solid #00E5FF;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1A2532;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00B7C7;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #00B7C7;
    border-radius: 3px;
}

QTableWidget {
    background-color: #0E141B;
    color: #D7E2EA;
    gridline-color: #223040;
    border: 1px solid #2C4054;
    border-radius: 8px;
    selection-background-color: #0E5660;
    selection-color: #FFFFFF;
}

QTableWidget::item {
    background-color: #0E141B;
    color: #D7E2EA;
    padding: 4px;
}

QTableWidget::item:selected {
    background-color: #0E5660;
    color: #FFFFFF;
}

QHeaderView {
    background-color: #111821;
    color: #D7E2EA;
}

QHeaderView::section {
    background-color: #111821;
    color: #D7E2EA;
    border: 1px solid #223040;
    padding: 5px;
}

QTableCornerButton::section {
    background-color: #111821;
    border: 1px solid #223040;
}
</string>
