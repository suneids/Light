	@test -d $(INSTALL_ROOT)/opt/radio-daemon/bin || mkdir -p $(INSTALL_ROOT)/opt/radio-daemon/bin
	$(QINSTALL_PROGRAM) /tmp/tmp.vEShsKfKkP/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/radio-daemon/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/radio-daemon/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/radio-daemon/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/radio-daemon/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

.SUFFIXES:

